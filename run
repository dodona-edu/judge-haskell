#!/bin/sh

# Compiles src/Judge.hs and runs it on Dodona's config from stdin: it judges the submission.
# Compiled rather than run with runghc, so no interpreter stays resident beside the tests;
# -dynamic because linking statically takes far more memory.

pkgdb="$(find "$HOME/.local/state/cabal/store" -name package.db -print -quit)"
src="$(dirname "$0")/src"
driver="$(mktemp -d)"
trap "rm -rf '$driver'" EXIT

ghc -v0 -dynamic -package-db "$pkgdb" -i"$src" -outputdir "$driver" -o "$driver/judge" "$src/Judge.hs" || exit 1
"$driver/judge" "$pkgdb"
